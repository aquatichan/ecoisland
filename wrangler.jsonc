{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecoisland",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unmatched paths fall back to index.html so react-router deep links work.
    "not_found_handling": "single-page-application",
    // Static assets are served before the Worker runs, so /api/* has to opt out.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
