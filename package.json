{
	"name": "ecoisland",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:emulators": "npx -y firebase-tools@15.34.2 emulators:start --project demo-ecoisland --only auth,firestore,storage",
		"typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
		"build": "pnpm typecheck && vite build",
		"lint": "eslint . --report-unused-disable-directives --max-warnings 0",
		"test": "vitest run",
		"test:emulator": "npx -y firebase-tools@15.34.2 emulators:exec --project demo-ecoisland --only auth,firestore,storage \"vitest run --config vitest.emulator.config.ts\"",
		"preview": "vite preview",
		"deploy": "pnpm run build && npx wrangler deploy",
		"deploy:rules": "npx -y firebase-tools@15.34.2 deploy --only firestore:rules,firestore:indexes,storage"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-tabs": "^1.1.13",
		"@tailwindcss/vite": "^4.1.13",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"firebase": "^12.3.0",
		"framer-motion": "^12.23.22",
		"lucide-react": "^0.544.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-router-dom": "^7.9.2",
		"tailwind-merge": "^3.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.36.0",
		"@firebase/rules-unit-testing": "5.0.0",
		"@types/node": "^24.5.2",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@typescript-eslint/eslint-plugin": "^8.17.0",
		"@typescript-eslint/parser": "^8.17.0",
		"@vitejs/plugin-react": "^4.3.4",
		"eslint": "^9.16.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.1.0",
		"eslint-plugin-react-refresh": "^0.4.16",
		"globals": "^16.4.0",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.7.2",
		"vite": "^6.4.0",
		"vitest": "3.2.4"
	}
}
