# Copy to .env.local for local development. Never commit .env.local.

# ── Option A: run everything locally against the Firebase emulators ──
# 1) In one terminal:  pnpm dev:emulators
# 2) In another:       pnpm dev
VITE_USE_EMULATORS=true
DEV_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=demo-ecoisland

# ── Option B: point the local API at the real project instead ──
# Remove the four lines above and set:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"ecoisland-b9e34",...}

# Optional: FRQ grading with Gemini
# GEMINI_API_KEY=

# Optional: streak reminder emails (Resend)
# RESEND_API_KEY=
# REMINDER_FROM=Ecoisland <reminders@ecoisland.xyz>
